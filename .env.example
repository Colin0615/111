# Polymarket AI Trader Configuration
# Copy this file to .env and fill in your values

# === Polymarket ===
POLYMARKET_PRIVATE_KEY=          # Polygon wallet private key (without 0x prefix)
POLYMARKET_API_KEY=              # CLOB API key (auto-derived if empty)
POLYMARKET_API_SECRET=           # CLOB API secret
POLYMARKET_API_PASSPHRASE=       # CLOB API passphrase

# === AI ===
ANTHROPIC_API_KEY=               # Claude API key (required)

# === News (optional, free tiers work) ===
NEWSAPI_KEY=                     # https://newsapi.org (free: 100 req/day)

# === Notifications (optional) ===
TELEGRAM_BOT_TOKEN=              # Telegram bot token
TELEGRAM_CHAT_ID=                # Your Telegram chat ID

# === Trading Parameters ===
INITIAL_BANKROLL=50              # Starting capital in USD
MAX_POSITION_SIZE=5              # Max per trade in USD
MIN_EDGE_THRESHOLD=0.08          # Minimum edge to trade (8%)
MAX_DAILY_TRADES=3               # Max trades per day
STOP_LOSS_PCT=0.20               # Stop trading at 20% total loss
KELLY_FRACTION=0.15              # Fraction of Kelly criterion to use
